# Optional local regression fixture. Course images are never included in releases.
SAMPLE_FITS=/absolute/path/to/example.fit
REFERENCE_PNG=/absolute/path/to/example_HR.png
# Local preview. Override when another application uses 8080.
HRDIAGRAM_PORT=8090
# Default publishing destination; the publish command also accepts --repository.
HRDIAGRAM_REPOSITORY=pu-shd/hrdiagram
